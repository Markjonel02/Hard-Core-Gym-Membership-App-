# Copy this file to `.env` and fill in the values from
# Firebase console → Project settings → General → Your apps → Web app.
#
# The values below are PLACEHOLDERS. Replace every one of them — the app will fail to
# reach Firebase until you do.
#
# These are compiled into the client bundle by design. A Firebase web config identifies
# the project; it does not grant access. Security comes from firestore.rules and the
# `role` custom claim. Never put the Gmail OAuth secrets here — those live in
# Secret Manager and are read only by Cloud Functions.

EXPO_PUBLIC_FIREBASE_API_KEY=your-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
