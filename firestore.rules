rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: the custom claim on the Auth token is the authoritative role source.
    //
    // A missing claim reads as 'member', and that default is load-bearing rather than tidy.
    // The claim is stamped by `provisionUser` in functions/src/roles.ts — a Cloud Function that
    // has never deployed, because Functions v2 builds through Cloud Build and this project is on
    // the Spark plan. So *every* admin-created login arrives with no claim at all, fails
    // isMember(), and is denied the read of its own members/{id} doc. The client cannot tell
    // that apart from having no membership: the listener's error callback in AuthContext sets
    // `member = null` either way, so the app showed "No membership linked yet" to people who
    // were fully paid up.
    //
    // Defaulting grants member-level access only. `staff` and `admin` still require a real
    // claim, which only the Admin SDK can set, so this does not widen privilege — it stops
    // withholding the baseline from accounts that were never given one.
    function role() {
      return request.auth.token.get('role', 'member');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember() {
      return isSignedIn() && role() == 'member';
    }

    function isStaff() {
      return isSignedIn() && (role() == 'staff' || role() == 'admin');
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    // The member->uid link lives on the member doc, so proving ownership of a payment or
    // check-in needs a join. This costs one extra read per evaluated doc, which is fine at
    // gym scale and is the only way to prove ownership without trusting a client field.
    function ownsMember(memberId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/members/$(memberId)).data.uid == request.auth.uid;
    }

    // Users can read their own profile. The role field is writable only by the
    // admin SDK (Functions), so a client cannot promote itself.
    //
    // `username` is pinned after creation. The authoritative copy is the `usernames/{name}`
    // reservation; this field is a convenience mirror for rendering. Letting a client edit it
    // freely would let a profile advertise a username its owner never reserved.
    // Staff read all accounts. This is what makes the admin user-management screen and the
    // team-access email lookup possible: both need to answer "which accounts exist and what
    // role does each hold?", which no amount of per-doc self-reads can answer. The exposure is
    // the staff-only profile fields already visible on the members screen, and `role` stays
    // unwritable from any client — promotion still goes through the admin-gated callable.
    //
    // Staff also *write* here, which is what backs the Edit modal on the Accounts screen: the
    // front desk corrects a misspelled name or a wrong phone number for someone who is not
    // themselves. The two guards below are what make that safe to hand over — neither `role`
    // nor `username` can be moved by any client, staff or not.
    match /users/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isStaff();
      allow create: if isSignedIn() && request.auth.uid == uid
                    && (!('role' in request.resource.data) || request.resource.data.role == 'member');
      allow update: if ((isSignedIn() && request.auth.uid == uid) || isStaff())
                    // `.get` rather than a bare field read: profiles written before the role
                    // mirror existed carry no `role` key, and touching a missing field errors
                    // the rule instead of failing it.
                    && (!('role' in request.resource.data)
                        || request.resource.data.role == resource.data.get('role', 'member'))
                    && (!('username' in request.resource.data)
                        || !('username' in resource.data)
                        || request.resource.data.username == resource.data.username);
    }

    // Username reservations. The doc id is the lowercased username, which is what makes
    // uniqueness real — `create` on an existing id fails, and update/delete are closed, so a
    // name cannot be reassigned or released by a client.
    //
    // `get` is public by necessity: sign-in has to turn a username into an email *before* the
    // user has a credential, so an anonymous read is the only way. The trade-off is that the
    // username -> email mapping is discoverable. It is bounded to that one pair — no name,
    // phone, membership, or payment data lives here — and knowing an email does not get an
    // attacker past the password. `list` stays denied so the set cannot be enumerated wholesale.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.username == username
                    && username.size() >= 3
                    && username.size() <= 20
                    // Reject anything the client did not lowercase, so `Juan` and `juan` cannot
                    // both be claimed as separate reservations for the same name.
                    && username == username.lower()
                    && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    // Members: a member reads only the doc where uid matches their auth uid.
    // Staff and admin read and write all members.
    match /members/{memberId} {
      allow read: if (isMember() && resource.data.uid == request.auth.uid) || isStaff();
      allow write: if isStaff();
    }

    // Plans: staff and admin manage; members read active plans only for the renewal flow.
    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // Payments: admin reads all for the sales dashboard; a member reads only the payments
    // attached to their own member doc (the receipt list on the Membership screen).
    // Staff create payments from the front desk; nobody edits or deletes one, because the
    // sales aggregates are derived from these docs and a silent edit would skew the totals.
    //
    // Walk-in fees live here too, as `kind: 'walkin'` with `memberId: null`. Putting them in
    // the same collection is what makes the revenue figure whole without special-casing: one
    // sum over `payments` covers memberships and day passes alike, and the CSV export needs no
    // second source. The read guard mirrors the one on `checkins` and for the same reason —
    // `ownsMember` does a get() on members/{memberId}, so a null id would *error* rule
    // evaluation and take a member's whole receipt list down with it, not merely hide one row.
    match /payments/{paymentId} {
      allow read: if isAdmin() || isStaff()
                  || (resource.data.get('kind', 'new') != 'walkin'
                      && ownsMember(resource.data.memberId));
      allow create: if isStaff()
                    && request.resource.data.amountCents is int
                    && request.resource.data.amountCents >= 0
                    && request.resource.data.kind in ['new', 'renewal', 'walkin'];
      allow update, delete: if false;
    }

    // The day-pass price, set once by an admin and read by the front desk when logging a
    // walk-in. Signed-in read rather than staff-only: a member glancing at the price of a guest
    // pass is not a leak, and the value is on the wall of the gym anyway.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Walk-ins. Staff-only in both directions, which is the whole reason the visitor's own
    // device never writes here: an unauthenticated phone would need `allow create: if true`,
    // and a world-writable collection is a far worse trade than accepting that the name inside
    // a scanned pass is self-asserted. The staff client creates the doc when it scans the QR.
    match /nonMembers/{nonMemberId} {
      allow read, write: if isStaff();
    }

    // Check-ins: members read their own; staff create them (QR scanner) and read the lot for
    // the attendance log.
    //
    // The `kind` guard is load-bearing, not defensive styling. `ownsMember` does a `get()` on
    // members/{memberId}, and a walk-in row carries `memberId: null` — evaluating that path
    // *errors* the rule rather than merely failing it, which would take the member's own
    // check-in list down with it. `.get('kind','member')` also defaults rows written before
    // walk-ins existed, all of which were members.
    match /checkins/{checkinId} {
      allow read: if isStaff()
                  || (resource.data.get('kind', 'member') == 'member'
                      && ownsMember(resource.data.memberId));
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // The audit trail. Admins read it; everyone signed in appends to it; nobody edits it.
    //
    // `update, delete: if false` is the line the whole collection rests on. The natural way to
    // record "one session" would be a login doc updated on the way out with the screens visited,
    // but any rule permitting that update — even scoped to the owner — lets a member rewrite or
    // blank their own trail, which is precisely what a log exists to prevent. So a session is two
    // immutable rows instead: a `login` written when auth resolves, and a `logout` carrying the
    // buffered screen list. An abrupt tab close loses only the second one, and a login with no
    // matching logout reads as exactly that on the admin screen.
    //
    // The uid guard stops one account writing rows in another's name. Combined with immutability
    // that makes the trail tamper-*evident*, not tamper-proof: the rows are still self-reported by
    // the client. Server-authored logs would need Cloud Functions, which have never deployed here.
    //
    // Failed sign-ins are deliberately absent. Recording them means a write from a caller with no
    // credential, and `allow create: if true` on an append-only collection anyone can discover is
    // a worse trade than losing them — same reasoning as `nonMembers` above. They stay in the
    // console via logAuthError.
    match /securityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Stats: admin-only reads for the dashboard. Only triggers write these.
    match /stats/daily/entries/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /stats/monthly/entries/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Announcements: everyone reads; staff create/edit.
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // Notifications: ledger written by Functions. Staff can read (for debugging).
    match /notifications/{notificationId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Rate limit counters, written only by Functions via the admin SDK. Stated explicitly
    // rather than left to the catch-all below: a limit a client could read would leak how
    // close it is to tripping, and one a client could write would not be a limit at all.
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
