# Non-secret function config. Copy to functions/.env and fill in.
# Safe to commit this example; do NOT commit .env.
GYM_NAME=Hardcore Gym

# Optional. Leave blank to send as the Gmail account that granted the refresh token.
# If set, it must be an address that account is allowed to send as.
GYM_FROM_EMAIL=
GYM_REPLY_TO=

# The Gmail OAuth credentials are NOT stored here — they live in Secret Manager:
#   firebase functions:secrets:set GMAIL_CLIENT_ID
#   firebase functions:secrets:set GMAIL_CLIENT_SECRET
#   firebase functions:secrets:set GMAIL_REFRESH_TOKEN
